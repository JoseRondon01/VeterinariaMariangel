// ---------------------------------------------------------------------------
// Schema Prisma — Clínica Veterinaria + Marketplace Multimoneda
// Provider: MySQL (Aiven, SSL REQUIRED)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// MODELOS EXISTENTES (Veterinaria)
// ===========================================================================

model Owner {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String?  @unique
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets          Pet[]
  appointments  Appointment[]
}

model Pet {
  id        Int      @id @default(autoincrement())
  name      String
  species   Species
  breed     String?
  birthDate DateTime?
  weight    Float?
  sex       Sex?
  microchip String?  @unique
  notes     String?

  ownerId Int
  owner   Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
}

model Veterinarian {
  id            Int      @id @default(autoincrement())
  firstName     String
  lastName      String
  fullName      String
  role          String
  specialty     String
  experience    String
  bio           String
  image         String?
  certifications Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  status    AppointmentStatus @default(pendiente)
  reason    String
  date      DateTime
  time      String
  notes     String?

  ownerId        Int
  owner          Owner @relation(fields: [ownerId], references: [id])
  petId          Int
  pet            Pet   @relation(fields: [petId], references: [id])
  veterinarianId Int?
  veterinarian   Veterinarian? @relation(fields: [veterinarianId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([petId])
  @@index([veterinarianId])
  @@index([date])
}

model BlogPost {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  excerpt      String
  content      String   @db.Text
  category     String
  tags         Json?
  coverImage   String?
  readingTime  String?
  published    Boolean  @default(false)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

model Service {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String   @db.Text
  icon        String?
  features    Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  pet       String?
  rating    Int      @default(5)
  text      String   @db.Text
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===========================================================================
// NUEVOS MODELOS (Marketplace)
// ===========================================================================

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("categories")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?   @db.Text
  priceUsd    Decimal   @db.Decimal(10, 2) @map("price_usd")
  stock       Int       @default(0)
  categoryId  Int?      @map("category_id")
  imageUrl    String?   @db.VarChar(500) @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ExchangeRate {
  id           Int       @id @default(autoincrement())
  currencyCode String    @unique @db.VarChar(3) @map("currency_code")
  unitsPerUsd  Decimal   @db.Decimal(12, 4) @map("units_per_usd")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

model Order {
  id                     Int       @id @default(autoincrement())
  customerName           String    @db.VarChar(255) @map("customer_name")
  customerPhone          String    @db.VarChar(50) @map("customer_phone")
  customerAddress        String?   @db.VarChar(500) @map("customer_address")
  totalUsd               Decimal   @db.Decimal(10, 2) @map("total_usd")
  selectedCurrency       String    @default("USD") @db.VarChar(3) @map("selected_currency")
  totalInSelectedCurrency Decimal  @db.Decimal(14, 2) @map("total_in_selected_currency")
  paymentMethod          PaymentMethod @map("payment_method")
  paymentStatus          PaymentStatus @default(pending) @map("payment_status")
  paymentProofDetails    Json?     @map("payment_proof_details")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  items                  OrderItem[]

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([paymentMethod])
  @@map("orders")
}

model OrderItem {
  id                Int     @id @default(autoincrement())
  orderId           Int     @map("order_id")
  productId         Int     @map("product_id")
  quantity          Int     @default(1)
  priceUsdAtPurchase Decimal @db.Decimal(10, 2) @map("price_usd_at_purchase")

  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model PaymentConfig {
  id              Int       @id @default(autoincrement())
  method          String    @unique @db.VarChar(50)
  label           String    @db.VarChar(100)
  bankName        String?   @db.VarChar(100) @map("bank_name")
  accountHolder   String?   @db.VarChar(255) @map("account_holder")
  accountNumber   String?   @db.VarChar(50) @map("account_number")
  phone           String?   @db.VarChar(50)
  instructions    String?   @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("payment_config")
}

model BusinessInfo {
  id              Int       @id @default(autoincrement())
  businessName    String    @default("Veterinaria Mariangel") @db.VarChar(255) @map("business_name")
  tagline         String?   @db.Text
  phone           String    @default("+541127258138") @db.VarChar(50)
  whatsappNumber  String    @default("541127258138") @db.VarChar(50) @map("whatsapp_number")
  email           String    @default("contacto@veterinariamariangel.com") @db.VarChar(255)
  address         String?   @db.Text
  mapEmbedUrl     String?   @db.Text @map("map_embed_url")
  schedule        Json?
  social          Json?
  hero            Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("business_info")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum Species {
  perro
  gato
  conejo
  ave
  reptil
  otro
}

enum Sex {
  macho
  hembra
}

enum AppointmentStatus {
  pendiente
  confirmada
  completada
  cancelada
}

enum PaymentMethod {
  pago_movil
  zelle
  cash_usd
  cash_cop
}

enum PaymentStatus {
  pending
  approved
  rejected
}