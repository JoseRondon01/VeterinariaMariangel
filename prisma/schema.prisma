// ---------------------------------------------------------------------------
// Schema Prisma - Clínica Veterinaria
// Gestiona citas, pacientes (mascotas), dueños, equipo médico y blog.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Cambiar a "postgresql" en producción
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Dueños de mascotas
// ---------------------------------------------------------------------------

model Owner {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String?  @unique
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets        Pet[]
  appointments Appointment[]
}

// ---------------------------------------------------------------------------
// Pacientes (mascotas)
// ---------------------------------------------------------------------------

model Pet {
  id        Int      @id @default(autoincrement())
  name      String
  species   Species
  breed     String?
  birthDate DateTime?
  weight    Float?   // en kg
  sex       Sex?
  microchip String?  @unique
  notes     String?

  ownerId Int
  owner   Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Equipo médico (veterinarios)
// ---------------------------------------------------------------------------

model Veterinarian {
  id            Int      @id @default(autoincrement())
  firstName     String
  lastName      String
  fullName      String
  role          String
  specialty     String
  experience    String
  bio           String
  image         String?
  certifications Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments Appointment[]
}

// ---------------------------------------------------------------------------
// Citas / Reservas
// ---------------------------------------------------------------------------

model Appointment {
  id        Int      @id @default(autoincrement())
  status    AppointmentStatus @default(pendiente)
  reason    String
  date      DateTime
  time      String   // formato HH:mm
  notes     String?

  ownerId        Int
  owner          Owner @relation(fields: [ownerId], references: [id])
  petId          Int
  pet            Pet   @relation(fields: [petId], references: [id])
  veterinarianId Int?
  veterinarian   Veterinarian? @relation(fields: [veterinarianId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([petId])
  @@index([veterinarianId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Blog / Portal de contenido SEO
// ---------------------------------------------------------------------------

model BlogPost {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  excerpt      String
  content      String
  category     String
  tags         Json?
  coverImage   String?
  readingTime  String?
  published    Boolean  @default(false)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Servicios ofrecidos
// ---------------------------------------------------------------------------

model Service {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String
  icon        String?
  features    Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Testimonios (prueba social)
// ---------------------------------------------------------------------------

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  pet       String?
  rating    Int      @default(5)
  text      String
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Species {
  perro
  gato
  conejo
  ave
  reptil
  otro
}

enum Sex {
  macho
  hembra
}

enum AppointmentStatus {
  pendiente
  confirmada
  completada
  cancelada
}